      </div>
    </main>
  </body>
</html>

<style is:global>
  /* tunnaduong.com — minimal personal site */

  :root {
    --ink: #000;
    --muted: #333;
    --bg: #fff;
    --page-top: 72px;
    --measure: 480px;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --ink: #fff;
      --muted: #ccc;
      --bg: #0a0a0a;
    }
  }

  * {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family:
      -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial,
      sans-serif;
    font-size: 15px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  .wrap {
    max-width: var(--measure);
    margin: 0 auto;
    padding: var(--page-top) 24px 96px;
  }

  /* ---------- logo ---------- */

  .logo {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    color: inherit;
    margin-bottom: 26px;
  }

  .logo__mark {
    width: 46px;
    height: 46px;
    flex: 0 0 auto;
    border: 3.5px solid var(--ink);
    border-radius: 0px 0px 16px 0px;
    display: flex;
    align-items: center;
    justify-content: left;
    font-weight: 700;
    font-size: 46px;
    line-height: 1;
    padding-bottom: 5px;
    padding-left: 4px;
  }

  .logo__name {
    font-size: 34px;
    letter-spacing: -0.015em;
    font-weight: 400;
  }

  /* ---------- nav ---------- */

  .nav {
    margin-bottom: 26px;
  }

  .nav a {
    color: var(--ink);
    text-decoration: none;
    margin-right: 4px;
  }

  .nav a:hover {
    text-decoration: underline;
  }

  .nav a[aria-current="page"] {
    font-weight: 700;
  }

  /* ---------- content ---------- */

  p {
    margin: 0 0 18px;
  }

  h2 {
    font-size: 15px;
    font-weight: 700;
    margin: 0;
  }

  h2 + p {
    margin-top: 0;
  }

  a {
    color: var(--ink);
  }

  .links {
    list-style: none;
    margin: 0 0 18px;
    padding: 0;
    font-weight: 700;
  }

  .links a {
    text-decoration: none;
  }

  .links a:hover {
    text-decoration: underline;
  }

  .posts {
    list-style: none;
    margin: 0 0 18px;
    padding: 0;
  }

  .posts li {
    margin-bottom: 10px;
  }

  .posts a {
    font-weight: 700;
    text-decoration: none;
  }

  .posts a:hover {
    text-decoration: underline;
  }

  .posts time {
    display: block;
    color: var(--muted);
    font-size: 13px;
  }

  /* ---------- footer ---------- */

  .contact {
    margin: 22px 0 14px;
  }

  .social {
    display: flex;
    gap: 9px;
    align-items: center;
  }

  .social a {
    color: var(--ink);
    line-height: 0;
  }

  .social a:hover {
    opacity: 0.6;
  }

  .social svg {
    width: 22px;
    height: 22px;
    fill: currentColor;
    display: block;
  }

  @media (max-width: 520px) {
    :root {
      --page-top: 44px;
    }

    .logo__name {
      font-size: 28px;
    }

    .logo__mark {
      width: 40px;
      height: 40px;
      font-size: 40px;
      padding-bottom: 4px;
    }
  }
</style>
